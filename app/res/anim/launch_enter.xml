<?xml version="1.0" encoding="utf-8"?>
<!-- An app opened from its tile: the home screen has already grown the tile into its launch screen (HomeView.drawLaunch);
     the app's window fades in over it, so its own splash takes over where ours stands. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quad"
    android:duration="260"
    android:fromAlpha="0.0" android:toAlpha="1.0" />
